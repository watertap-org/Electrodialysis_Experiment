# top-level metadata
include README.md
include pyproject.toml
include LICENSE.md
include COPYRIGHT.md

# ------------------------------------------------------------------
# In-package data files (redundant for safety; setuptools picks them up
# via [tool.setuptools.package-data] in pyproject.toml)
# ------------------------------------------------------------------
recursive-include src/electrodialysis_experiment/configs *.yaml *.yml
recursive-include src/electrodialysis_experiment/data/raw *.csv *.parquet

# ------------------------------------------------------------------
# Explicitly EXCLUDE anything else that might be large, temporary,
# or not intended for distribution
# ------------------------------------------------------------------
prune src/electrodialysis_experiment/data/tmp
prune src/electrodialysis_experiment/data/intermediate
prune src/electrodialysis_experiment/data/derived
prune src/electrodialysis_experiment/data/output
prune notebooks
prune tests
